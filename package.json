{
  "name": "snapbooth",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:check": "node scripts/check-db.mjs",
    "db:schema": "node scripts/db-schema.mjs",
    "db:seed": "node scripts/seed.mjs",
    "db:verify": "node scripts/verify-db.mjs",
    "test:api": "node scripts/api-smoke-test.mjs create test-artifacts/api-test-ids.json",
    "test:api:cleanup": "node scripts/api-smoke-test.mjs cleanup test-artifacts/api-test-ids.json",
    "test:ui": "node scripts/ui-check.mjs",
    "test:e2e": "node scripts/e2e-booth.mjs",
    "uploads:cleanup": "node scripts/cleanup-uploads.mjs --apply"
  },
  "dependencies": {
    "mysql2": "^3.24.6",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "playwright-core": "^1.65.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3"
  }
}
