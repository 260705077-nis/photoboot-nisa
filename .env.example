# Salin menjadi .env.local dan isi dengan kredensial asli.
DATABASE_URL="mysql://USER:PASSWORD@HOST:PORT/DATABASE"

# String acak panjang untuk menandatangani cookie sesi.
AUTH_SECRET="ganti-dengan-string-acak-panjang"

# Akun seed. Password minimal 8 karakter.
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="ganti-password-admin"
SEED_DEMO_EMAIL="demo@example.com"
SEED_DEMO_PASSWORD="ganti-password-demo"
